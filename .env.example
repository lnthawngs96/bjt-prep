# ============================================================
# Ứng dụng
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Sinh secret bằng: openssl rand -base64 32 — production PHẢI dùng secret riêng
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — xem docs/google-oauth.md
# Tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email được gán vai trò ADMIN lúc tài khoản được TẠO (đăng nhập lần đầu).
# Chỉ để bootstrap admin đầu tiên; sau đó đổi vai trò ở /admin/users.
# Nhiều email cách nhau bằng dấu phẩy.
ADMIN_EMAILS=

# ============================================================
# Database — Neon Postgres. Xem docs/db-setup.md.
#
# Để TRỐNG cả hai thì app chạy trên dữ liệu mock (không đăng nhập bền, không
# lưu bài làm). Đặt DATABASE_URL thì tầng dữ liệu tự chuyển sang Prisma.
#
# DATABASE_URL          = chuỗi POOLED (host có "-pooler") — runtime dùng
# DATABASE_URL_UNPOOLED = chuỗi trực tiếp (không "-pooler") — prisma migrate dùng
# ============================================================

# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# Cloudflare R2 — chưa dùng. Media hiện là file tĩnh trong public/.
# ============================================================

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
