# ============================================================
# Giai đoạn giao diện (Phase 1–3) — chỉ cần các biến dưới đây
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth (Phase 2)
# Sinh secret bằng: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Phase 2)
# Tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vai trò admin giai đoạn tĩnh — Phase 4 sẽ đọc từ cột `role` bảng user
# TODO(db): bỏ biến này sau khi nối Prisma adapter
ADMIN_EMAILS=

# ============================================================
# Database — CHƯA CẦN cho Phase 1–3.
# Xem docs/db-setup.md khi bạn sẵn sàng bật Neon.
# ============================================================

# DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/bjt?sslmode=require"

# ============================================================
# Cloudflare R2 — Phase 4
# ============================================================

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
